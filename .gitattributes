# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.py        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf

# Batch files must keep CRLF for Windows
*.bat       text eol=crlf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.svg       text
*.mp4       binary
*.mov       binary
*.pdf       binary
*.zip       binary

# Linguist: treat these as documentation
docs/**     linguist-documentation
