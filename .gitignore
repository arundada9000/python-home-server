# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── Logs ────────────────────────────────────────────────
*.log

# ── Config / secrets ────────────────────────────────────
config.json
!config.json.example
.env
.env.*
!.env.example
*.pem
*.key

# ── App data (auto-generated logs/db) ───────────────────
data/*
!data/.gitkeep

# ── User-uploaded content (Home) ────────────────────────
Home/*
!Home/Portal.html
!Home/Commands.html
!Home/Todo.html
!Home/Dashboard.json
!Home/useful-info
!Home/commands
!Home/server-icons
Home/.recycle_bin/
Home/.collaborative/
Home/qr.png

# ── My own to-do list ───────────────────────────────────
to-do.txt

# ── OS junk ─────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Editors ─────────────────────────────────────────────
.idea/
*.swp
